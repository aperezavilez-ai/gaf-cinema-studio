{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gafcinemastudio.com/schemas/deployment-status.v1.json",
  "title": "DeploymentStatus",
  "type": "object",
  "required": ["service", "version", "mvp", "connections"],
  "properties": {
    "service": { "type": "string" },
    "version": { "type": "string" },
    "mvp": {
      "type": "object",
      "properties": {
        "phases": { "type": "string" },
        "status": { "type": "string", "enum": ["complete", "in_progress"] }
      }
    },
    "connections": {
      "type": "object",
      "required": ["github", "vercel", "supabase"],
      "properties": {
        "github": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["linked", "pending", "error"] },
            "repo": { "type": "string" }
          }
        },
        "vercel": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["deployed", "pending", "error"] },
            "region": { "type": ["string", "null"] }
          }
        },
        "supabase": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["configured", "pending", "error"] },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
